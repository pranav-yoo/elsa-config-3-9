# Run requests ONE AT A TIME in VS Code REST Client, not Send All.
# Named responses work within this file. Copy the required IDs between files.
# Completion may return 202: retry the next GET until the next task appears.
# A new action needs a new operationId; retry an old command with its ORIGINAL body/UUID/revision.
@baseUrl = http://localhost:5000
@adminPassword = password
@samplePassword = Password123!

### Admin login
# @name adminLogin
POST {{baseUrl}}/elsa/api/identity/login
Content-Type: application/json

{
  "username": "admin",
  "password": "{{adminPassword}}"
}


### Inspect existing roles
# Inspect first. Skip provisioning POSTs below when the role/user already exists. Native list fields are roles/users, not items.
# @name existingRoles
GET {{baseUrl}}/elsa/api/identity/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}


### Inspect existing users
# Inspect first. Skip provisioning POSTs below when the role/user already exists. Native list fields are roles/users, not items.
# @name existingUsers
GET {{baseUrl}}/elsa/api/identity/users
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}


### Create role Approver IF MISSING
# Native Elsa API; run once. Do not recreate an existing role.
# @name createRoleApprover
POST {{baseUrl}}/elsa/api/identity/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "id": "Approver",
  "name": "Approver",
  "permissions": [
    "user-tasks:view",
    "user-tasks:claim",
    "user-tasks:complete",
    "workflows/instances:view"
  ]
}


### Create role Requester IF MISSING
# Native Elsa API; run once. Do not recreate an existing role.
# @name createRoleRequester
POST {{baseUrl}}/elsa/api/identity/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "id": "Requester",
  "name": "Requester",
  "permissions": [
    "user-tasks:view",
    "user-tasks:complete",
    "workflows/definitions:view",
    "workflows/definitions:execute",
    "workflows/instances:view"
  ]
}


### Create role Configurator IF MISSING
# Native Elsa API; run once. Do not recreate an existing role.
# @name createRoleConfigurator
POST {{baseUrl}}/elsa/api/identity/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "id": "Configurator",
  "name": "Configurator",
  "permissions": [
    "workflows/definitions:*",
    "workflows/instances:view"
  ]
}


### Create role Supervisor IF MISSING
