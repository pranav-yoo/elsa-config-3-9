Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "id": "Supervisor",
  "name": "Supervisor",
  "permissions": [
    "user-tasks:view",
    "user-tasks:assign",
    "user-tasks:supervise",
    "workflows/instances:view"
  ]
}


### Create configured-requester IF MISSING
# Elsa generates id. Copy the returned user id into Workflow-Configuration.http; a username is not the user ID.
# @name createUserRequester
POST {{baseUrl}}/elsa/api/identity/users
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "configured-requester",
  "password": "{{samplePassword}}",
  "roles": [
    "Requester"
  ]
}


