# Run requests ONE AT A TIME in VS Code REST Client, not Send All.
# Named responses work within this file. Copy the required IDs between files.
# Completion may return 202: retry the next GET until the next task appears.
# A new action needs a new operationId; retry an old command with its ORIGINAL body/UUID/revision.
@baseUrl = http://localhost:5000
@adminPassword = password
@samplePassword = Password123!
# Provision using Authentication.http first; copy the generated IDs below.
# Do not substitute usernames, task IDs or workflow instance IDs for these employee IDs.
@definitionId = configured-expense-v1
@aliceId = PASTE_ALICE_USER_ID
@amyId = PASTE_AMY_USER_ID
@bobId = PASTE_BOB_USER_ID
@claraId = PASTE_CLARA_USER_ID
@danId = PASTE_DAN_USER_ID

### Login: configured-configurator
# Use accessToken in Swagger without adding Bearer. Tokens expire; sign in again when needed.
# @name configuratorLogin
POST {{baseUrl}}/elsa/api/identity/login
Content-Type: application/json

{
  "username": "configured-configurator",
  "password": "{{samplePassword}}"
}


### Create configuration + native Elsa draft
# No workflow_version, so this creates the definition and its first version. Omit workflow_definition_id too to get a generated one. Attributes are not configurable for now: the API stores an empty attributes list.
# @name createConfiguration
POST {{baseUrl}}/api/workflow-configurations
Authorization: Bearer {{configuratorLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "workflow_definition_id": "{{definitionId}}",
  "configuration": {
    "name": "Configured Expense Claim",
    "start_stage": "A",
    "stages": [
      {
        "key": "A",
        "title": "A Initial review",
        "assignment": {
          "policy": "Bucket",
          "members": [
            "{{aliceId}}",
            "{{amyId}}"
          ]
        },
        "actions": [
          { "key": "APPROVE", "label": "Approve", "destination": { "kind": "Stage", "stage_key": "B" } },
          { "key": "REJECT", "label": "Reject", "destination": { "kind": "Correction", "stage_key": "A" } }
        ]
      },
      {
        "key": "B",
        "title": "B Claims review",
        "assignment": {
          "policy": "Bucket",
          "members": [
            "{{bobId}}"
          ]
        },
        "actions": [
          {
            "key": "APPROVE",
            "label": "Approve",
            "destination": { "kind": "Stage", "stage_key": "D" }
          },
          { "key": "REJECT", "label": "Reject", "destination": { "kind": "Stage", "stage_key": "A" } },
          { "key": "REFER_UW", "label": "Refer to UW", "destination": { "kind": "Stage", "stage_key": "C" }, "require_reason": true }
        ]
      },
      {
        "key": "C",
        "title": "C High-value approval",
        "assignment": {
          "policy": "Bucket",
          "members": [
            "{{claraId}}"
          ]
        },
        "actions": [
          { "key": "APPROVE", "label": "Approve", "destination": { "kind": "Stage", "stage_key": "D" } },
          { "key": "REJECT", "label": "Reject", "destination": { "kind": "Rejected" } }
        ]
      },
      {
        "key": "D",
        "title": "D Final approval",
        "assignment": {
          "policy": "Specific",
          "members": [
            "{{danId}}"
          ]
        },
        "actions": [
          { "key": "APPROVE", "label": "Approve", "destination": { "kind": "Approved" } },
          { "key": "REJECT", "label": "Reject", "destination": { "kind": "Correction", "stage_key": "D" } }
        ]
      }
    ]
  }
}


### Read draft
# POST so both keys travel in the body. workflow_version is optional: omit it to read the latest version.
# @name readConfiguration
POST {{baseUrl}}/api/workflow-configurations/get
Authorization: Bearer {{configuratorLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "workflow_definition_id": "{{createConfiguration.response.body.$.data.workflow_definition_id}}",
  "workflow_version": {{createConfiguration.response.body.$.data.workflow_version}}
}


### Update same draft using POST
# Same endpoint as create. Pass BOTH workflow_definition_id and workflow_version to update that draft; the response revision grows on every save and is never sent. An unknown version number returns 404; editing a published version returns 409. Object references are intentionally unquoted JSON.
# @name updateConfiguration
POST {{baseUrl}}/api/workflow-configurations
Authorization: Bearer {{configuratorLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "workflow_definition_id": "{{readConfiguration.response.body.$.data.workflow_definition_id}}",
  "workflow_version": {{readConfiguration.response.body.$.data.workflow_version}},
  "configuration": {
    "name": "{{readConfiguration.response.body.$.data.configuration.name}}",
    "start_stage": "{{readConfiguration.response.body.$.data.configuration.start_stage}}",
    "stages": {{readConfiguration.response.body.$.data.configuration.stages}}
  }
}


### Validate without publishing
# 200 valid=true; FluentValidation failures return 400 with field/message errors.
# @name validateConfiguration
POST {{baseUrl}}/api/workflow-configurations/{{createConfiguration.response.body.$.data.workflow_definition_id}}/versions/{{createConfiguration.response.body.$.data.workflow_version}}/validate
Authorization: Bearer {{configuratorLogin.response.body.$.accessToken}}


### Publish exact Elsa version
# Copy workflow_definition_id into Ticket-Workflow.http. This version is now immutable.
# @name publishConfiguration
POST {{baseUrl}}/api/workflow-configurations/{{createConfiguration.response.body.$.data.workflow_definition_id}}/versions/{{createConfiguration.response.body.$.data.workflow_version}}/publish
Authorization: Bearer {{configuratorLogin.response.body.$.accessToken}}

# END MAIN SEQUENCE

### OPTIONAL next version
# A definition id WITHOUT workflow_version creates the next version (the response carries its new workflow_version number). Edit it by sending both. Only one open draft per definition; existing instances remain pinned to their original version.
# @name nextVersion
POST {{baseUrl}}/api/workflow-configurations
Authorization: Bearer {{configuratorLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "workflow_definition_id": "{{publishConfiguration.response.body.$.data.workflow_definition_id}}",
  "configuration": {
    "name": "{{publishConfiguration.response.body.$.data.configuration.name}}",
    "start_stage": "{{publishConfiguration.response.body.$.data.configuration.start_stage}}",
    "stages": {{publishConfiguration.response.body.$.data.configuration.stages}}
  }
}

