<Project>
  <!-- One place for every NuGet version. Elsa packages must all stay on the same version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Elsa" Version="3.9.0" />
    <PackageVersion Include="Elsa.Expressions.JavaScript" Version="3.9.0" />
    <PackageVersion Include="Elsa.Http" Version="3.9.0" />
    <PackageVersion Include="Elsa.Identity" Version="3.9.0" />
    <PackageVersion Include="Elsa.Persistence.EFCore.PostgreSql" Version="3.9.0" />
    <PackageVersion Include="Elsa.UserTasks" Version="3.9.0" />
    <PackageVersion Include="Elsa.UserTasks.Persistence.EFCore.PostgreSql" Version="3.9.0" />
    <PackageVersion Include="Elsa.Workflows.Api" Version="3.9.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
  </ItemGroup>
</Project>
