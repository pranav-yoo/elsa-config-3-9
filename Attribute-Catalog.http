# Configure fields BEFORE the workflow. Run one request at a time.
# Sending an existing workflow_definition_id WITHOUT workflow_version creates its next version (409 while a draft is open).
# To edit a draft, POST both workflow_definition_id and workflow_version. Draft saves resolve current conditional fields
# for the same workflow_definition_id.
# Published versions and their instances retain their saved snapshot.
@baseUrl = http://localhost:5000
@definitionId = catalog-expense-p3
@samplePassword = Password123!
# Elsa user id of configured-alice (from its create-user response in Authentication.http).
@aliceId = PASTE_CONFIGURED_ALICE_USER_ID

### Login as internal configurator/admin
# @name catalogAdmin
POST {{baseUrl}}/elsa/api/identity/login
Content-Type: application/json

{ "username": "admin", "password": "password" }

### Preconfigure an active field; id omitted/0 creates, positive id updates
# @name amountField
POST {{baseUrl}}/api/workflow-attributes
Authorization: Bearer {{catalogAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "definition_id": "{{definitionId}}",
  "status": "Active",
  "attribute": { "key": "claimAmount", "type": "Decimal", "required": true, "minimum": 0 }
}

### An inactive field cannot be used in a condition
POST {{baseUrl}}/api/workflow-attributes
Authorization: Bearer {{catalogAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "definition_id": "{{definitionId}}", "status": "Inactive", "attribute": { "key": "oldNotes", "type": "String" } }

### Inspect the master (shows both statuses)
GET {{baseUrl}}/api/workflow-attributes?definition_id={{definitionId}}
Authorization: Bearer {{catalogAdmin.response.body.$.accessToken}}

### Create the native Elsa family using YOUR workflow_definition_id
# The approval condition maps claimAmount from the catalog and makes it required.
# @name catalogDraft
POST {{baseUrl}}/api/workflow-configurations
Authorization: Bearer {{catalogAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "workflow_definition_id": "{{definitionId}}",
  "configuration": {
    "name": "Catalog expense claim",
    "start_stage": "A",
    "stages": [{
      "key": "A", "title": "Alice approval",
      "assignment": { "policy": "Specific", "members": ["{{aliceId}}"] },
      "actions": [
        { "key": "APPROVE", "label": "Approve", "destination": { "kind": "Rejected" },
          "rules": [{
            "conditions": [ { "attribute": "claimAmount", "operator": "GreaterThan", "value": 5000 } ],
            "destination": { "kind": "Approved" }
          }] },
        { "key": "REJECT", "label": "Reject", "destination": { "kind": "Rejected" } }
      ]
    }]
  }
}

### Publish the saved attribute snapshot
# @name catalogPublished
POST {{baseUrl}}/api/workflow-configurations/{{catalogDraft.response.body.$.data.workflow_definition_id}}/versions/{{catalogDraft.response.body.$.data.workflow_version}}/publish
Authorization: Bearer {{catalogAdmin.response.body.$.accessToken}}

### Internal user starts the instance with the mapped conditional attributes
# @name catalogRun
POST {{baseUrl}}/elsa/api/workflow-definitions/{{definitionId}}/execute
Authorization: Bearer {{catalogAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "input": { "attributes": { "claimAmount": 6000 } } }

### Alice logs in
# @name catalogAlice
POST {{baseUrl}}/elsa/api/identity/login
Content-Type: application/json

{ "username": "configured-alice", "password": "{{samplePassword}}" }

### Alice finds her task
# @name catalogTask
GET {{baseUrl}}/elsa/api/user-tasks?scope=assigned&status=Assigned&workflowInstanceId={{catalogRun.response.body.$.workflowState.id}}
Authorization: Bearer {{catalogAlice.response.body.$.accessToken}}

### Alice approves (claimAmount > 5000 routes to Approved)
POST {{baseUrl}}/elsa/api/user-tasks/{{catalogTask.response.body.$.items[0].id}}/complete
Authorization: Bearer {{catalogAlice.response.body.$.accessToken}}
Content-Type: application/json

{ "expectedRevision": {{catalogTask.response.body.$.items[0].revision}}, "operationId": "{{$guid}}", "actionKey": "APPROVE", "data": {} }
